# Neon Postgres (pooled connection string)
DATABASE_URL=
# >=32 chars random; `openssl rand -base64 48`
AUTH_SECRET=
# Optional: separate Neon branch for integration tests
TEST_DATABASE_URL=
# 32 bytes base64: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
# Seeding the first super admin (scripts/seed.ts)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# M8 AI drafting (optional). Without a key, AI drafting is reported unavailable — there is no fake fallback.
ANTHROPIC_API_KEY=
AI_MODEL=

# Staging only: lets accounts flagged is_test_account (demo seed) skip mandatory MFA enrolment. Leave unset in production.
ALLOW_TEST_MFA_BYPASS=
